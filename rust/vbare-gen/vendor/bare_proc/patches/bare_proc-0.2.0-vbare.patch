+
+fn syntax_error(error: pest::error::Error<Rule>) -> String {
+    let (line, column) = match error.line_col {
+        LineColLocation::Pos(position) | LineColLocation::Span(position, _) => position,
+    };
+    format!("{line}:{column}: {}", error.variant.message())
